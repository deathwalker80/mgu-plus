# Per-car SSH keys generated at enrollment - never commit private keys
data/enrollments/

# Session logs (may contain VIN / MGU IP) - never commit
data/logs/
*.log

# Python / PyInstaller build artifacts
__pycache__/
*.pyc
build/
dist/

# Prebuilt app bundles - distributed via GitHub Releases, not committed
*.zip
# Coding backups (contain VIN / coding) - never commit
data/preflight/
# mgu-store installer downloaded at run time (GPL-3.0, from its own release)
data/mgu-store/
